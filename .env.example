# 环境配置
ENV=development
SERVER_ADDR=:8080

# 数据库配置
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=anonymous_community

# Redis配置
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=

# JWT密钥（生产环境必须修改）
JWT_SECRET=your-secret-key-change-in-production

# 日志级别
LOG_LEVEL=info

# 对象存储配置（可选）
STORAGE_ENDPOINT=
STORAGE_KEY=
STORAGE_SECRET=
